rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // Master inicial (bootstrap) — sempre Master, mesmo sem doc em usuarios.
    function isBootstrapMaster() {
      return isSignedIn() && email() == 'alexandre.magalhaes@udiaco.com.br';
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/usuarios/$(email()));
    }
    function userData() {
      return get(/databases/$(database)/documents/usuarios/$(email())).data;
    }
    // Autorizado = master bootstrap OU tem doc em usuarios com ativo != false.
    function isAuthorized() {
      return isSignedIn() && (
        isBootstrapMaster() ||
        (hasUserDoc() && userData().ativo != false)
      );
    }
    // Master = bootstrap OU papel == 'master' (e ativo).
    function isMaster() {
      return isSignedIn() && (
        isBootstrapMaster() ||
        (hasUserDoc() && userData().ativo != false && userData().papel == 'master')
      );
    }
    // Papel restrito UM989: só acessa a coleção um989.
    function isUM989() {
      return isSignedIn() && hasUserDoc() && userData().papel == 'um989';
    }
    // Acesso por PLATAFORMA (o Master marca pessoa por pessoa na tela Acessos,
    // no campo 'plataformas' do doc de usuarios). Plataforma nova nasce
    // fechada: sem a marcação, nega. O Master entra em todas.
    function temPlataforma(chave) {
      return isAuthorized() && (
        isMaster() ||
        ('plataformas' in userData() &&
         chave in userData().plataformas &&
         userData().plataformas[chave] == true)
      );
    }

    // ── Controle de acesso (usuarios) ─────────────────────────
    // Qualquer autenticado lê (o app precisa ler o próprio papel);
    // só o Master escreve. Exceção: o master-bootstrap cria o próprio doc.
    match /usuarios/{id} {
      allow read:  if isSignedIn();
      allow write: if isMaster() || (isBootstrapMaster() && id == email());
      // Cada pessoa pode trocar a PRÓPRIA foto — e só a foto, nada de papel,
      // plataformas ou 'ativo'. É o que permite subir o rosto do próprio
      // perfil dentro do Projetos Estratégicos.
      allow update: if isSignedIn() && id == email() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto']);
    }

    // ── Dados do sistema ──────────────────────────────────────
    // Somente usuários autorizados leem e escrevem.
    // Dados da Udiaço: usuários autorizados, EXCETO o papel restrito UM989.
    match /colaboradores/{id} { allow read, write: if isAuthorized() && !isUM989(); }
    match /lancamento/{id}    { allow read, write: if isAuthorized() && !isUM989(); }
    match /historico/{id}     { allow read, write: if isAuthorized() && !isUM989(); }
    match /basesSalvas/{id}   { allow read, write: if isAuthorized() && !isUM989(); }
    match /config/{id}        { allow read, write: if isAuthorized() && !isUM989(); }
    match /premioDados/{id}    { allow read, write: if isAuthorized() && !isUM989(); }
    // Férias UM989: apenas o Master e o papel UM989.
    match /um989/{id}         { allow read, write: if isMaster() || isUM989(); }

    // Log de exclusões (justificativas de quem excluiu do histórico).
    match /logsExclusao/{id}  { allow read, write: if isAuthorized() && !isUM989(); }

    // Contabilização: log de processamento do FPRF002.OPE (só metadados).
    match /contabilizacao_historico/{id} { allow read, write: if isAuthorized() && !isUM989(); }
    // Contabilização: esquema contábil (evento -> contas de débito/crédito).
    match /esquemaContabil/{id} { allow read, write: if isAuthorized() && !isUM989(); }

    // ── Treinamentos ──────────────────────────────────────────
    // Login único: leitura e escrita apenas por usuários autorizados,
    // EXCETO o papel UM989 (que só acessa Férias UM989).
    match /treinamentos/{id}  {
      allow read:  if isAuthorized() && !isUM989();
      allow write: if isAuthorized() && !isUM989();
    }

    // ── Projetos Estratégicos (projetos.html) ─────────────────
    // Mesmo login do RH, mas plataforma própria: só entra o Master e quem ele
    // marcou em 'Projetos Estratégicos'. Esconder o cartão no portal não basta
    // — quem não tem a plataforma é barrado aqui, no banco.
    function podeProjetos() {
      return temPlataforma('projetos') && !isUM989();
    }
    match /pe_projetos/{id}  { allow read, write: if podeProjetos(); }
    match /pe_tarefas/{id}   { allow read, write: if podeProjetos(); }
    match /pe_mensagens/{id} { allow read, write: if podeProjetos(); }
    // Notificações (sino): cada um lê as suas; escrever é preciso para avisar
    // o outro (quem responde cria a notificação de quem pediu).
    match /pe_notificacoes/{id} { allow read, write: if podeProjetos(); }
    // Configuração da plataforma (hoje: integração com o Google Drive).
    // Todo mundo lê — o app precisa do Client ID para pedir o token —, mas só
    // o Master altera.
    match /pe_config/{id} {
      allow read:  if podeProjetos();
      allow write: if isMaster();
    }

    // ── Comercial (comercial.html) ────────────────────────────
    // Mesmo login do RH, plataforma própria: só o Master e quem ele marcou em
    // 'Comercial'. Guarda os painéis de BI de teste (metadados + o HTML em
    // pedaços) e as demandas de tecnologia com a empresa parceira.
    function podeComercial() {
      return temPlataforma('comercial') && !isUM989();
    }
    match /cm_paineis/{id}      { allow read, write: if podeComercial(); }
    match /cm_painel_dados/{id} { allow read, write: if podeComercial(); }
    match /cm_demandas/{id}     { allow read, write: if podeComercial(); }

    // ── Qualquer outra coleção: negado ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
